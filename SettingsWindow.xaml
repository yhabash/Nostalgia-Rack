<!--
  SettingsWindow.xaml: Advanced settings (Ctrl+, or the ⚙ key on the case).
  A bare champagne faceplate (like the player, no case), drawn at 85% so it sits with the
  player's proportions, with dark glass fields like the player's display.
  Sections: Output · Playback · Internet radio · Podcasts · Library · Appearance · Keyboard shortcuts.
  What the controls do is in SettingsWindow.xaml.cs.
-->
<Window x:Class="NostalgiaRack.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced settings – Nostalgia Rack"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource LabelFont}">

    <Window.Resources>
        <!-- The champagne scrollbar for the long page -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}"/>

        <Style x:Key="Field" TargetType="ComboBox" BasedOn="{StaticResource GlassCombo}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldText" TargetType="TextBox" BasedOn="{StaticResource GlassTextBox}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource SmokeBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AmberBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border Width="552" Height="600" Style="{StaticResource Faceplate}" BorderBrush="#86764F" BorderThickness="1">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
        </Border.LayoutTransform>
            <DockPanel>

                <!-- Title strip (drag the window here) -->
                <Grid DockPanel.Dock="Top" Height="44" Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                    <TextBlock Text="NOSTALGIA RACK" FontFamily="{StaticResource NameplateFont}" FontSize="10"
                               Foreground="{StaticResource InkBrush}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ADVANCED SETTINGS" Style="{StaticResource Engraved}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource TextKey}" Content="✕" HorizontalAlignment="Right" Margin="0,0,14,0"
                            VerticalAlignment="Center" Width="26" Click="Cancel_Click" ToolTip="Close without saving"/>
                    <Border Style="{StaticResource PinH}" VerticalAlignment="Bottom" Margin="16,0"/>
                </Grid>

                <!-- Buttons at the bottom -->
                <Grid DockPanel.Dock="Bottom" Height="52">
                    <Border Style="{StaticResource PinH}" VerticalAlignment="Top" Margin="16,0"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource EngravedTiny}" HorizontalAlignment="Left"
                               VerticalAlignment="Center" Margin="20,0,0,0" ToolTip="The version of Nostalgia Rack you're running"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Style="{StaticResource TextKey}" Content="CANCEL" Width="78" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                        <Button Style="{StaticResource TextKey}" Content="APPLY" Width="78" Margin="0,0,8,0" Click="Apply_Click"/>
                        <Button Style="{StaticResource TextKey}" Content="OK" Width="78" Click="Ok_Click" IsDefault="True"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Padding="24,4,16,12"
                              CanContentScroll="False" PreviewMouseWheel="SettingsScroll_PreviewMouseWheel">
                    <StackPanel>

                        <!-- ============ OUTPUT ============ -->
                        <TextBlock Text="OUTPUT" Style="{StaticResource SettingHeader}" Margin="0,10,0,8"/>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Output device" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="DeviceCombo" Grid.Column="1" Style="{StaticResource Field}"/>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Mode" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SharedMode" Style="{StaticResource SourceKey}" GroupName="Mode" Content="SHARED" Width="90" Margin="0,0,6,0"/>
                                    <RadioButton x:Name="ExclusiveMode" Style="{StaticResource SourceKey}" GroupName="Mode" Content="EXCLUSIVE" Width="90"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SettingHint}" Width="300" HorizontalAlignment="Left"
                                           Text="Shared plays alongside other apps. Exclusive gives Nostalgia Rack the device alone, bit-perfect, with Windows' mixer and volume out of the way. Other apps go silent while it plays."/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Resampler quality" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="ResamplerCombo" Grid.Column="1" Style="{StaticResource Field}"/>
                        </Grid>

                        <!-- ============ PLAYBACK ============ -->
                        <TextBlock Text="PLAYBACK" Style="{StaticResource SettingHeader}"/>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Crossfade" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Glass}" Width="300" Height="26" HorizontalAlignment="Left">
                                    <DockPanel Margin="10,0,10,0">
                                        <TextBlock x:Name="CrossfadeText" DockPanel.Dock="Right" Width="62" TextAlignment="Right"
                                                   Style="{StaticResource DisplayGlow}" FontSize="10" VerticalAlignment="Center" Text="GAPLESS"/>
                                        <Slider x:Name="CrossfadeSlider" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="20"
                                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                                VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="CrossfadeSlider_ValueChanged"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock Style="{StaticResource SettingHint}" Width="300" HorizontalAlignment="Left"
                                           Text="All the way left = gapless: songs follow each other with no gap at all. Up to 20 seconds of crossfade. It never happens between songs from the same album, or on radio."/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="ReplayGain" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel Grid.Column="1">
                                <ComboBox x:Name="ReplayGainCombo" Style="{StaticResource Field}" IsEnabled="False"/>
                                <TextBlock Style="{StaticResource SettingHint}" Width="300" HorizontalAlignment="Left"
                                           Text="Evens out loudness between songs. Arrives in Milestone 7."/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Skip back / forward" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="SeekStepCombo" Grid.Column="1" Style="{StaticResource Field}"/>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="VU meter delay" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel Grid.Column="1">
                                <ComboBox x:Name="BluetoothCombo" Style="{StaticResource Field}"/>
                                <TextBlock Style="{StaticResource SettingHint}" Width="300" HorizontalAlignment="Left"
                                           Text="Bluetooth headphones play a little late. Delay the needles so they move with what you hear."/>
                            </StackPanel>
                        </Grid>

                        <!-- ============ INTERNET RADIO ============ -->
                        <TextBlock Text="INTERNET RADIO" Style="{StaticResource SettingHeader}"/>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Network buffer" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel Grid.Column="1">
                                <ComboBox x:Name="NetBufferCombo" Style="{StaticResource Field}"/>
                                <TextBlock Style="{StaticResource SettingHint}" Width="300" HorizontalAlignment="Left"
                                           Text="More buffer rides out a shaky connection, but stations take longer to start."/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Start playing at" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="PreBufferCombo" Grid.Column="1" Style="{StaticResource Field}"/>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Content filter" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel Grid.Column="1">
                                <ComboBox x:Name="RadioFilterCombo" Style="{StaticResource Field}"/>
                                <TextBlock Style="{StaticResource SettingHint}" Width="300" HorizontalAlignment="Left"
                                           Text="Applies to TOP STATIONS and station search. Stations label themselves, so this is a strong hint, not a guarantee, and any station can still play a song with explicit lyrics. Your saved favourites are always shown."/>
                            </StackPanel>
                        </Grid>

                        <!-- ============ PODCASTS ============ -->
                        <TextBlock Text="PODCASTS" Style="{StaticResource SettingHeader}"/>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,-4,0,10" Width="470" HorizontalAlignment="Left">
                            Podcast search uses the free Podcast Index. Sign up at
                            <Hyperlink NavigateUri="https://api.podcastindex.org/signup" RequestNavigate="Link_RequestNavigate">api.podcastindex.org</Hyperlink>,
                            then paste the key and secret here. They are stored encrypted, only on this PC, for your Windows account.
                            You don't need them to subscribe by feed address.
                        </TextBlock>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="API key" Style="{StaticResource SettingLabel}"/>
                            <TextBox x:Name="PodcastKeyBox" Grid.Column="1" Style="{StaticResource FieldText}" Tag="PASTE THE KEY"/>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="API secret" Style="{StaticResource SettingLabel}"/>
                            <PasswordBox x:Name="PodcastSecretBox" Grid.Column="1" Style="{StaticResource FieldPassword}"/>
                        </Grid>

                        <!-- ============ LIBRARY ============ -->
                        <TextBlock Text="LIBRARY" Style="{StaticResource SettingHeader}"/>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Music folders" Style="{StaticResource SettingLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource TextKey}" Content="FOLDERS…" Width="90" Click="LibraryFolders_Click"/>
                                <TextBlock x:Name="FolderCountText" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ============ APPEARANCE ============ -->
                        <TextBlock Text="APPEARANCE" Style="{StaticResource SettingHeader}"/>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                            <StackPanel Grid.Column="1">
                                <ComboBox x:Name="ThemeCombo" Style="{StaticResource Field}"/>
                                <TextBlock Style="{StaticResource SettingHint}" Width="300" HorizontalAlignment="Left"
                                           Text="More finishes may come later."/>
                            </StackPanel>
                        </Grid>

                        <!-- ============ KEYBOARD SHORTCUTS ============ -->
                        <Grid Margin="0,16,0,8">
                            <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource SettingHeader}" Margin="0"/>
                            <Button Style="{StaticResource TextKey}" Content="RESET ALL" HorizontalAlignment="Right" Width="80"
                                    Margin="0,0,8,0" Click="ResetShortcuts_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,-4,0,10" Width="470" HorizontalAlignment="Left"
                                   Text="Click a box and press the new key. Single keys are best (for example X or B); combinations like Ctrl+P work too. Single letters are ignored while you type in the search box. The media keys on your keyboard always work."/>
                        <StackPanel x:Name="ShortcutPanel"/>
                        <TextBlock x:Name="ShortcutMessage" Style="{StaticResource SettingHint}" Foreground="#8A3A1E" Margin="0,4,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
    </Border>
</Window>
