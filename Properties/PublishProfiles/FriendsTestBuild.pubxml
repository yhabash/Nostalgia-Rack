<?xml version="1.0" encoding="utf-8"?>
<!--
  "Friends test build": makes a folder anyone with Windows 10 or 11 (64-bit) can run,
  without installing .NET, Visual Studio or anything else.
  In Visual Studio: right-click the project → Publish… → FriendsTestBuild → Publish.
  The result lands in bin\publish\NostalgiaRack. Zip that folder and share it.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\publish\NostalgiaRack\</PublishDir>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Carries its own copy of .NET, so your friends don't need to install it -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
